# S.P.I.D.Y AI Voice Assistant - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file with real API keys to version control.

# Groq Cloud API Key (Get free key at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (Current supported model)
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI Whisper Model Size: tiny, base, small, medium, large
# Recommended for RTX 3050 6GB: 'base'
WHISPER_MODEL_SIZE=base

# Default Whisper transcription language: auto, en, etc.
WHISPER_LANGUAGE=auto

# Optional Weather & News API Keys (Free wttr.in & RSS feeds used if blank)
WEATHER_API_KEY=
NEWS_API_KEY=

# Server & Debug Mode
SPIDY_DEBUG=false
PORT=5000
